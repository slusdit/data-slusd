# Prisma
DATABASE_URL="mysql://username:password@host:port/database"

# Google OAuth for Auth.js
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# Auth.js setup
AUTH_SECRET='your_auth_secret_key'
NEXTAUTH_SECRET='your_nextauth_secret'
NEXTAUTH_URL='http://localhost:3000'

# Aeries connection
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SERVER=your_db_server
DB_DATABASE=your_database_name

# Aeries API
AERIES_API_KEY=your_aeries_api_key
# Server-only (no NEXT_PUBLIC_ prefix): the API base URL is never needed in the browser.
AERIES_URL=https://your-aeries-instance.domain.com/Aeries.Net

# Changing queries
QUERY_ASSESSMENT_GRADE_PERCENTAGE=your_query_id

# AG Grid License
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=your_ag_grid_license_key

# FastAPI Server
# Server-only — never expose FastAPI credentials to the browser (no NEXT_PUBLIC_).
# Requests are proxied through /api/fastapi/* which injects these server-side.
FAST_API_URL='http://your-fastapi-server:port'
FAST_API_USER='fastAPI_username'
FAST_API_PASSWORD='fastAPI_password'

# AI Query Builder - LLM Configuration
# Option 1: Google Gemini (recommended) - paid-tier key recommended (repair loop
# can make up to 4 calls per user query; free tier is ~10 RPM)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-2.5-flash

# Option 2: Local LLM (Ollama) - for development
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Option 3: OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your_openai_key
# LLM_MODEL=gpt-4o-mini

# Common LLM settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=30000
# Set to 'true' to log prompts/SQL/emails for debugging (PII - leave off in production)
# AI_QUERY_DEBUG=false
# MySQL 8 only: path to a PEM file holding the server RSA public key, i.e. the output of
#   SHOW STATUS LIKE 'Caching_sha2_password_rsa_public_key';
# Without it the first connection after a MySQL restart fails (caching_sha2_password full auth
# needs the key and the MariaDB driver will not fetch it over the wire). See lib/db.ts.
DATABASE_RSA_PUBLIC_KEY_PATH="/path/to/mysql-rsa-public-key.pem"
